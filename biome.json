{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/alfenctl/web/static/**",
      "!src/alfenctl/web/static/vendor"
    ]
  },
  "formatter": { "enabled": false },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noDescendingSpecificity": "off" },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error"] } }
      }
    }
  }
}
